# ==============================================================================
# Git Ignore - Industrial Digital Twin & Predictive Maintenance System
# ==============================================================================

# Credentials, Secrets & Local Environment Configs
.env
.env.*
*.env
nexus/.env
!.env.example
!nexus/.env.example

# Local SQLite Runtime Databases & Write-Ahead Logs
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
nexus/data/*.sqlite3*
data/*.sqlite3*

# Python Artifacts & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/

# Node & Frontend Dependencies
node_modules/
.npm
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Local Files
.claude/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# Transient Test / Runtime Output
predictive_maintenance/data/raw/*.csv
*.log
scratch/
